# Copy to .env for local development. Never commit the real .env.
# In production these are set as Render environment variables (sync: false).

# OpenAI — embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# DeepSeek — chat (deepseek-chat), see ADR-0001
DEEPSEEK_API_KEY=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=caravista

# Meta WhatsApp Cloud API (see README_WHATSAPP.md)
# Permanent System User access token (whatsapp_business_messaging permission)
META_ACCESS_TOKEN=
# Phone Number ID from WhatsApp → API Setup (not the phone number itself)
META_PHONE_NUMBER_ID=
# Any string you choose; must match the one entered in Meta's webhook config
META_VERIFY_TOKEN=
# App secret from App Settings → Basic (validates webhook signatures)
META_APP_SECRET=
# Set to true ONLY for local testing to skip webhook signature validation
SKIP_SIGNATURE_VALIDATION=
